MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=5000
# Comma-separated list of sites allowed to call the API: Vite dev server, and the Android (Capacitor) WebView.
CLIENT_ORIGIN=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost
